{
  "manifest_version": 3,
  "name": "Sidebar Notes",
  "description": "A fast, local place for notes.",
  "version": "1.0.1",
  "permissions": ["storage", "sidePanel"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Sidebar Notes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "side_panel": { "default_path": "dist/src/sidepanel/index.html" }
}
